# ============================
# 钉钉机器人配置
# ============================
# 钉钉开放平台 -> 应用开发 -> 企业内部开发 -> 创建应用后获取
DINGTALK_APP_KEY=your_dingtalk_app_key
DINGTALK_APP_SECRET=your_dingtalk_app_secret
# 钉钉机器人的 Webhook 地址 (用于主动发送消息, 群机器人设置中获取)
DINGTALK_ROBOT_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx

# ============================
# Teambition 配置 (阿里云版)
# ============================
# 阿里云 Teambition 开放平台 -> 创建应用后获取
TEAMBITION_APP_ID=your_teambition_app_id
TEAMBITION_APP_SECRET=your_teambition_app_secret
# 组织 ID, 在 Teambition 管理后台获取
TEAMBITION_ORG_ID=your_teambition_org_id
# 默认项目 ID, 在 Teambition 项目 URL 中获取
TEAMBITION_DEFAULT_PROJECT_ID=your_default_project_id
# 看板视图 ID, 在 Teambition 项目看板 URL 中获取 (/tasks/view/{viewId}/...)
TEAMBITION_DEFAULT_VIEW_ID=your_default_view_id
# 项目前缀 (如 BP3)，在 Teambition 任务详情页左上角查看
TEAMBITION_PROJECT_KEY=your_project_key

# ============================
# LLM 配置
# ============================
# 支持 OpenAI 兼容接口 (OpenAI / 通义千问 / DeepSeek 等)
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 备用 LLM (主模型配额耗尽时自动切换，留空则不启用)
# provider: openai (默认，兼容 OpenAI 接口) 或 anthropic
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_API_KEY=your_fallback_llm_api_key
LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
LLM_FALLBACK_MODEL=deepseek-chat

# 使用 Anthropic 代理示例:
# LLM_FALLBACK_PROVIDER=anthropic
# LLM_FALLBACK_API_KEY=sk-xxx
# LLM_FALLBACK_BASE_URL=https://api.nagara.top
# LLM_FALLBACK_MODEL=claude-3-5-haiku-20241022
